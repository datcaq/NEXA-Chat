<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:cardCornerRadius="16dp"
 app:cardElevation="1dp" app:cardBackgroundColor="@android:color/white">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:gravity="center_vertical" android:padding="12dp" android:orientation="horizontal">
  <TextView android:id="@+id/groups_avatar" android:layout_width="48dp" android:layout_height="48dp"
   android:gravity="center" android:background="@drawable/groups_avatar" android:textColor="@android:color/white"
   android:textSize="20sp" android:importantForAccessibility="no" />
  <TextView android:id="@+id/groups_row_text" android:layout_width="0dp" android:layout_height="wrap_content"
   android:layout_weight="1" android:paddingHorizontal="12dp" android:textSize="16sp" android:textColor="#172B28" />
  <com.google.android.material.button.MaterialButton android:id="@+id/groups_row_action"
   android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" />
  <com.google.android.material.button.MaterialButton android:id="@+id/groups_row_secondary"
   android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" />
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
