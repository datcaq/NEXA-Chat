<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contacts_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/contacts_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/contacts_title"
            android:textAppearance="?attr/textAppearanceHeadline4"
            android:textColor="@color/home_text"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/home_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/home_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contacts_search_title"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:accessibilityHeading="true"
                    android:textColor="@color/home_text" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contacts_search_help"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/home_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/contacts_region"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="start|center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/contacts_choose_region"
                    android:textAllCaps="false"
                    android:textColor="@color/home_accent"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/home_outline" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/contacts_phone_field"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/contacts_phone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/contacts_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="phone"
                        android:imeOptions="actionSearch"
                        android:maxLength="32"
                        android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/contacts_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="48dp"
                    android:text="@string/contacts_search"
                    android:textAllCaps="false"
                    android:textColor="@color/home_surface"
                    app:backgroundTint="@color/home_accent"
                    app:cornerRadius="12dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/contacts_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/home_accent" />

                <TextView android:id="@+id/contacts_search_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contacts_search_initial"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/home_secondary" />

                <LinearLayout
                    android:id="@+id/contacts_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/contacts_result_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:textColor="@color/home_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/contacts_send_invitation"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:minHeight="48dp"
                        android:text="@string/contacts_invite"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contacts_friends_title"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:textColor="@color/home_text" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contacts_friends_unavailable"
            android:textAppearance="?attr/textAppearanceBody2"
            android:layout_marginTop="6dp"
            android:textColor="@color/home_secondary" />
        <TextView android:id="@+id/contacts_invitation_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contacts_invitation_title"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:textColor="@color/home_text" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/contacts_invitation_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/contacts_received"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/contacts_received"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/contacts_sent"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/contacts_sent"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView android:id="@+id/contacts_invitation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contacts_received_unavailable"
            android:textAppearance="?attr/textAppearanceBody2"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/home_secondary" />
    </LinearLayout>
</ScrollView>
